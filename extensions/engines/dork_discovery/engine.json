{
  "manifestVersion": "engine.v5",
  "engineId": "engine.lunafox.dork_discovery",
  "publisher": "iamHuFei",
  "execution": {
    "engineApiMajor": 2,
    "supportedTargetTypes": [
      "domain",
      "ip"
    ],
    "configSections": [
      {
        "id": "dork_search",
        "defaultEnabled": true,
        "params": [
          {
            "key": "dorks",
            "type": "stringArray",
            "default": [
              "site:{target}",
              "site:{target} inurl:login",
              "site:{target} inurl:admin"
            ],
            "minItems": 1,
            "maxItems": 16
          },
          {
            "key": "use-browser",
            "type": "boolean",
            "default": false
          },
          {
            "key": "provider",
            "type": "string",
            "default": "bing",
            "enum": [
              "bing"
            ],
            "minLength": 1
          },
          {
            "key": "max-pages",
            "type": "integer",
            "default": 3,
            "minimum": 1,
            "maximum": 10
          },
          {
            "key": "page-size",
            "type": "integer",
            "default": 50,
            "minimum": 10,
            "maximum": 50
          },
          {
            "key": "request-timeout",
            "type": "integer",
            "default": 10,
            "unit": "seconds",
            "minimum": 1,
            "maximum": 60
          },
          {
            "key": "request-delay-ms",
            "type": "integer",
            "default": 4500,
            "minimum": 0,
            "maximum": 10000
          },
          {
            "key": "proxy-url",
            "type": "string",
            "default": "http://172.17.0.1:7890",
            "maxLength": 300
          },
          {
            "key": "wayback",
            "type": "boolean",
            "default": false
          },
          {
            "key": "wayback-limit",
            "type": "integer",
            "default": 200,
            "minimum": 0,
            "maximum": 2000
          },
          {
            "key": "wayback-max-age-years",
            "type": "integer",
            "default": 3,
            "minimum": 0,
            "maximum": 20
          }
        ]
      },
      {
        "id": "probe",
        "defaultEnabled": true,
        "params": [
          {
            "key": "unreachable-policy",
            "type": "string",
            "default": "record",
            "enum": [
              "record",
              "skip"
            ],
            "minLength": 1
          },
          {
            "key": "request-timeout",
            "type": "integer",
            "default": 8,
            "unit": "seconds",
            "minimum": 1,
            "maximum": 60
          },
          {
            "key": "concurrency",
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 20
          },
          {
            "key": "body-limit-kb",
            "type": "integer",
            "default": 64,
            "minimum": 1,
            "maximum": 512
          },
          {
            "key": "follow-redirects",
            "type": "boolean",
            "default": true
          },
          {
            "key": "timeout",
            "type": "integer",
            "default": 600,
            "unit": "seconds",
            "minimum": 60,
            "maximum": 3600
          }
        ]
      }
    ]
  }
}
